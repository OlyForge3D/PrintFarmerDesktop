# Normalize line endings to LF for all text files so formatting checks are
# stable across Windows and macOS CI.
* text=auto eol=lf

# Binary assets: never normalize.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.stl binary
*.3mf binary

# Vendored presets preserve exact upstream bytes, including whitespace.
resources/target-profiles/**/profiles/** -text -whitespace

# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union
.squad/rai/audit-trail.md merge=union
.squad/fact-checker/audit-trail.md merge=union

# Malicious-input corpus fixtures (#158) are byte-exact by construction: magic
# bytes, declared-vs-actual lengths, and offsets are the thing under test, so
# no normalization may touch them.
tests/fixtures/malicious-input/** -text
# The generator is ordinary repository source, not a fixture, so it keeps
# normal end-of-line handling.
tests/fixtures/malicious-input/generate.mjs text eol=lf
