# Node / Electron / Vite
node_modules/
dist/
out/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Electron Forge / packaging
.webpack/
release/
*.asar

# Rust sidecar
native/**/target/
**/*.rs.bk
Cargo.lock.orig

# Staged sidecar binary and compliance bundle (built into packaged app via
# forge extraResource)
resources/sidecar/
resources/compliance/

# Generated SBOM. Derived from the lockfiles at build time and staged into
# resources/compliance/; committing it would let it drift from the tree it
# claims to describe.
build/

# TypeScript build artifacts
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# E2E temp state dirs (created/cleaned by calibration.spec.ts beforeAll/afterAll)
.pf-e2e-*/
.pf-cal-e2e-*/

# Goal workflow artifacts
.goals/

# Secrets, signing material, local config (NEVER commit)
*.pem
*.pfx
*.p12
*.mobileprovision
*.cer
*.key
# Base64-encoded key material staged for `gh secret set`
*.b64
.env
.env.*
!.env.example
signing/
notarization/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.swp
