# Node / Electron / Vite
node_modules/
dist/
out/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Electron Forge / packaging
.webpack/
release/
*.asar

# Rust sidecar
native/**/target/
**/*.rs.bk
Cargo.lock.orig

# Staged sidecar binary and compliance bundle (built into packaged app via
# forge extraResource)
resources/sidecar/
resources/compliance/

# Both rules above are keyed to a PATH, not to the artifact, so relocating the
# directory un-ignores its contents. The #267 reproduction does exactly that --
# it renames resources/sidecar aside to prove a test no longer depends on the
# binary -- and the result is a 3.4 MB native executable sitting untracked,
# which `git add -A` and `git add .` will stage without comment. (`git commit
# -am` will not: -a stages only tracked modifications, so it lists the binary
# under untracked and stops. The safe-looking command is the dangerous one.)
#
# So key the sidecar executable by name as well. Scoped to resources/ because
# an unscoped `model-core` pattern would shadow native/model-core/, which holds
# 66 tracked source files -- a fix considerably worse than the defect.
resources/**/model-core
resources/**/model-core.exe

# Generated SBOM. Derived from the lockfiles at build time and staged into
# resources/compliance/; committing it would let it drift from the tree it
# claims to describe.
build/

# TypeScript build artifacts
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# E2E temp state dirs (created/cleaned by calibration.spec.ts beforeAll/afterAll)
.pf-e2e-*/
.pf-cal-e2e-*/

# Goal workflow artifacts
.goals/

# Ralph's per-round delta-scan state. Machine-written every hour and only
# meaningful on the machine that produced it; committing it would churn the
# history and hand stale head SHAs to another checkout.
.squad/agents/ralph/.state.json

# Secrets, signing material, local config (NEVER commit)
*.pem
*.pfx
*.p12
*.mobileprovision
*.cer
*.key
# Base64-encoded key material staged for `gh secret set`
*.b64
.env
.env.*
!.env.example
signing/
notarization/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.swp
