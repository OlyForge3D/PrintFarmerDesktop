{
  "name": "printfarmer-desktop",
  "productName": "PrintFarmer Desktop",
  "version": "0.1.0-beta.2",
  "description": "Local-first desktop 3D model library integrated with PrintFarmer",
  "author": "OlyForge3D",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OlyForge3D/PrintFarmerDesktop.git"
  },
  "bugs": {
    "url": "https://github.com/OlyForge3D/PrintFarmerDesktop/issues"
  },
  "homepage": "https://github.com/OlyForge3D/PrintFarmerDesktop#readme",
  "main": ".vite/build/main.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:verify": "node scripts/install-git-hooks.mjs --verify",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build:sidecar": "node scripts/stage-sidecar.mjs",
    "build:sidecar:universal": "node scripts/build-universal-sidecar.mjs",
    "stage:sidecar": "node scripts/stage-sidecar.mjs --no-build",
    "generate:update-metadata": "node scripts/generate-update-metadata.mjs",
    "update:snapmaker-presets": "node scripts/update-snapmaker-presets.mjs",
    "verify:target-profiles": "node scripts/verify-target-profiles.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "verify:sbom": "node scripts/verify-sbom.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "verify:notices": "node scripts/verify-notices.mjs",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "audit:advisories": "node scripts/audit-advisories.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:closing-references": "node scripts/check-closing-references.mjs",
    "check:provenance": "node scripts/check-calibration-provenance.mjs",
    "check:closure-scope": "node scripts/check-pr-closure-scope.mjs",
    "check:stacked-base": "node scripts/check-stacked-base.mjs",
    "check:merge-queue-contexts": "node scripts/check-merge-queue-contexts.mjs",
    "check:merge-landed": "node scripts/check-merge-landed.mjs",
    "check:required-contexts": "node scripts/check-required-contexts.mjs",
    "check:protection-assumptions": "node scripts/check-protection-assumptions.mjs",
    "check:script-reachability": "node scripts/check-script-reachability.mjs",
    "check:sequencing-hold": "node scripts/check-sequencing-hold.mjs",
    "check:citation-reachability": "node scripts/check-citation-reachability.mjs",
    "check:review-coverage": "node scripts/check-review-head-coverage.mjs",
    "instrument:probe": "node scripts/instrument-probe.mjs",
    "lift:sequencing-hold": "node scripts/lift-hold-on-close.mjs",
    "mutation:harness": "node scripts/mutation-harness.mjs",
    "probe:sha-query": "node scripts/probe-sha-query.mjs",
    "seam:injected-defaults": "node scripts/check-injected-defaults.mjs",
    "push:force": "node scripts/safe-force-push.mjs",
    "sha:status": "node scripts/sha-status.mjs",
    "merge:survival": "node scripts/merge-survival.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:gpu-qualification": "node scripts/release-gpu-qualification.mjs verify",
    "test:e2e": "playwright test",
    "pretest:e2e": "node scripts/build-e2e.mjs",
    "lift:sequencing-hold:backfill": "node scripts/lift-hold-on-close.mjs --backfill"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-fuses": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@electron-forge/shared-types": "^7.6.0",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "2.5.0",
    "@electron/osx-sign": "1.3.3",
    "@electron/windows-sign": "1.2.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "electron": "^33.2.1",
    "electron-winstaller": "5.4.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^14.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "spdx-expression-parse": "^3.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
