{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/OlyForge3D/PrintFarmerDesktop/blob/development/compliance/printer-calibration-provenance.schema.json",
  "title": "PrintFarmer Desktop Printer Calibration provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "feature",
    "repository",
    "approvedSource",
    "derivedRoots",
    "sourceDecisions",
    "pathPolicies",
    "derivedFiles"
  ],
  "properties": {
    "$schema": {
      "const": "./printer-calibration-provenance.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "feature": {
      "const": "printer-calibration"
    },
    "repository": {
      "$ref": "#/definitions/repository"
    },
    "approvedSource": {
      "$ref": "#/definitions/approvedSource"
    },
    "derivedRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/repositoryPath"
      }
    },
    "sourceDecisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/sourceDecision"
      }
    },
    "pathPolicies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/pathPolicy"
      }
    },
    "derivedFiles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/derivedFile"
      }
    }
  },
  "definitions": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "license", "licenseReview"],
      "properties": {
        "name": {
          "const": "OlyForge3D/PrintFarmerDesktop"
        },
        "license": {
          "const": "AGPL-3.0-only"
        },
        "licenseReview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "issue",
            "approvedBy",
            "approvedAt",
            "decisionReference"
          ],
          "properties": {
            "status": {
              "enum": ["pending-maintainer-approval", "approved", "rejected"]
            },
            "issue": {
              "$ref": "#/definitions/httpsUrl"
            },
            "approvedBy": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "approvedAt": {
              "type": ["string", "null"],
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "decisionReference": {
              "anyOf": [
                {
                  "$ref": "#/definitions/httpsUrl"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "approvedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonicalRepository",
        "tag",
        "tagUrl",
        "releaseUrl",
        "commit",
        "commitUrl",
        "tree",
        "archive",
        "license",
        "packageMetadata",
        "eligibilityDecision"
      ],
      "properties": {
        "id": {
          "const": "calibration-source-v1.3.2"
        },
        "canonicalRepository": {
          "$ref": "#/definitions/httpsUrl"
        },
        "tag": {
          "const": "v1.3.2"
        },
        "tagUrl": {
          "$ref": "#/definitions/httpsUrl"
        },
        "releaseUrl": {
          "$ref": "#/definitions/httpsUrl"
        },
        "commit": {
          "$ref": "#/definitions/sha1"
        },
        "commitUrl": {
          "$ref": "#/definitions/httpsUrl"
        },
        "tree": {
          "$ref": "#/definitions/sha1"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256", "bytes"],
          "properties": {
            "url": {
              "$ref": "#/definitions/httpsUrl"
            },
            "sha256": {
              "$ref": "#/definitions/sha256"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "path", "blob", "url"],
          "properties": {
            "spdx": {
              "const": "AGPL-3.0-only"
            },
            "path": {
              "const": "License"
            },
            "blob": {
              "$ref": "#/definitions/sha1"
            },
            "url": {
              "$ref": "#/definitions/httpsUrl"
            }
          }
        },
        "packageMetadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "blob",
            "url",
            "declaredVersion",
            "declaredLicense"
          ],
          "properties": {
            "path": {
              "const": "package.json"
            },
            "blob": {
              "$ref": "#/definitions/sha1"
            },
            "url": {
              "$ref": "#/definitions/httpsUrl"
            },
            "declaredVersion": {
              "const": "1.3.2"
            },
            "declaredLicense": {
              "const": "AGPL-3.0-only"
            }
          }
        },
        "eligibilityDecision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "authority", "recordedAt"],
          "properties": {
            "status": {
              "const": "first-eligible-source"
            },
            "authority": {
              "$ref": "#/definitions/httpsUrl"
            },
            "recordedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    },
    "sourceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "sourceBlob",
        "decision",
        "category",
        "reason"
      ],
      "properties": {
        "sourcePath": {
          "$ref": "#/definitions/repositoryPath"
        },
        "sourceBlob": {
          "$ref": "#/definitions/sha1"
        },
        "decision": {
          "enum": ["eligible-for-review", "exclude", "rewrite-only"]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "pathPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "decision", "category", "reason"],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": ["exclude", "rewrite-only"]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "derivedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "sourcePath",
        "sourceBlob",
        "destinationPath",
        "destinationSha256",
        "spdxLicense",
        "originalNotices",
        "modifiedAt",
        "modifications",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "classification": {
          "enum": ["reused-source", "adapted-source", "ported-test"]
        },
        "sourcePath": {
          "$ref": "#/definitions/repositoryPath"
        },
        "sourceBlob": {
          "$ref": "#/definitions/sha1"
        },
        "destinationPath": {
          "$ref": "#/definitions/repositoryPath"
        },
        "destinationSha256": {
          "$ref": "#/definitions/sha256"
        },
        "spdxLicense": {
          "const": "AGPL-3.0-only"
        },
        "originalNotices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modifiedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "modifications": {
          "type": "string",
          "minLength": 10
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reviewedBy",
            "reviewedAt",
            "decisionReference"
          ],
          "properties": {
            "decision": {
              "const": "approved"
            },
            "reviewedBy": {
              "type": "string",
              "minLength": 1
            },
            "reviewedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "decisionReference": {
              "$ref": "#/definitions/httpsUrl"
            }
          }
        }
      }
    }
  }
}
