{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "matcher": "edit|create|apply_patch",
        "bash": "node \"$(git rev-parse --show-toplevel)/scripts/design-detector-hook.mjs\"",
        "powershell": "node \"$(git rev-parse --show-toplevel)/scripts/design-detector-hook.mjs\"",
        "timeoutSec": 30
      }
    ]
  }
}
